# Environment Variables for Testnet Deployment

# IMPORTANT: Never commit this file with real values!
# Copy this to .env and fill in your actual values

# Private key from your wallet (without 0x prefix)
# Get this from MetaMask: Account Details > Export Private Key
# WARNING: Keep this SECRET! Never share or commit!
PRIVATE_KEY=your_private_key_here

# Sepolia RPC URL
# Get free API key from: https://www.alchemy.com/ or https://infura.io/
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR-API-KEY

# Etherscan API Key (for contract verification)
# Get from: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Optional: Other testnets
# GOERLI_RPC_URL=https://eth-goerli.g.alchemy.com/v2/YOUR-API-KEY
# MUMBAI_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/YOUR-API-KEY
